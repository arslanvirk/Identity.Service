{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Attach to Docker",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "identity-service-api-debug"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceRoot}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "justMyCode": false,
      "logging": {
        "moduleLoad": false
      }
    },
    {
      "name": ".NET Core Launch (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Identity.Service.Web/bin/Debug/net9.0/Identity.Service.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Identity.Service.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8080"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": ".NET Core Launch (Docker)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-debug-up",
      "program": "/app/Identity.Service.Web.dll",
      "args": [],
      "cwd": "/app",
      "stopAtEntry": false,
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "identity-service-api-debug"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceRoot}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "justMyCode": false
    }
  ]
}
