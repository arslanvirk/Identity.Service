# ============================================================================
# DEBUG DOCKERFILE - FOR DEVELOPMENT WITH REMOTE DEBUGGING
# ============================================================================
# This Dockerfile is optimized for development and debugging.
# It includes the debugger (vsdbg) and uses Debug build configuration.
# ============================================================================

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base

# Install debugging tools
# - curl: For health checks
# - wget: For downloading vsdbg
# - unzip: For extracting vsdbg
# - procps: For process management (ps, kill, etc.)
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Visual Studio Remote Debugger (vsdbg)
# This allows Visual Studio/VS Code to attach to the running container
RUN curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg

WORKDIR /app
EXPOSE 8080 8081

# ============================================================================
# BUILD STAGE - Debug Configuration
# ============================================================================
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Debug
WORKDIR /src

# Copy project files
COPY ["Identity.Service.Web/Identity.Service.Web.csproj", "Identity.Service.Web/"]
COPY ["Identity.Service.Application/Identity.Service.Application.csproj", "Identity.Service.Application/"]
COPY ["Identity.Service.Core/Identity.Service.Core.csproj", "Identity.Service.Core/"]
COPY ["Identity.Service.Infrastructure/Identity.Service.Infrastructure.csproj", "Identity.Service.Infrastructure/"]

# Restore packages
RUN dotnet restore "./Identity.Service.Web/Identity.Service.Web.csproj"

# Copy source code
COPY . .

# Build with Debug symbols
WORKDIR "/src/Identity.Service.Web"
RUN dotnet build "./Identity.Service.Web.csproj" \
    -c $BUILD_CONFIGURATION \
    -o /app/build \
    --no-restore

# ============================================================================
# PUBLISH STAGE - Debug Configuration
# ============================================================================
FROM build AS publish
ARG BUILD_CONFIGURATION=Debug

RUN dotnet publish "./Identity.Service.Web.csproj" \
    -c $BUILD_CONFIGURATION \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

# ============================================================================
# FINAL DEBUG IMAGE
# ============================================================================
FROM base AS final

ENV ASPNETCORE_ENVIRONMENT=Development \
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS=false

WORKDIR /app
COPY --from=publish /app/publish .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "Identity.Service.Web.dll"]
