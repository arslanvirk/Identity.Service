# Production Environment Variables Template
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# JWT Configuration
JWT_ISSUER=https://your-domain.com
JWT_AUDIENCE=your-audience
JWT_SIGNING_KEY=your-secure-signing-key-min-32-chars

# Database Configuration
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=identitydb
POSTGRES_USER=postgres
CONNECTION_STRING=Host=db;Port=5432;Database=identitydb;Username=postgres;Password=your-secure-password;Pooling=true

# pgAdmin Configuration
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your-secure-pgadmin-password

# Optional: Image Tags (default: latest)
# IMAGE_TAG=latest
# IMAGE_TAG=<git-sha>
